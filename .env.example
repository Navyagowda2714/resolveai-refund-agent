# LLM provider: anthropic | openai | ollama | offline (falls back to offline if no key is set)
LLM_PROVIDER=offline
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Application
RESOLVEAI_DB_PATH=data/resolveai.db
RESOLVEAI_MAX_TOOL_CALLS=8
RESOLVEAI_ENFORCE_GUARDRAILS=true
